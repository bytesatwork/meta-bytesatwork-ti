From 87fe62f712408f266eb788c0dcb294406fc88375 Mon Sep 17 00:00:00 2001
From: Simone Schwizer <simone.schwizer@bytesatwork.ch>
Date: Mon, 20 Jul 2026 14:10:24 +0200
Subject: [PATCH] am62lx: Add AM62Lx bytesatwork byteDEVKIT board
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add basic AM62Lx bytesatwork byteDEVKIT board support.

Signed-off-by: Stephan Dünner <stephan.duenner@bytesatwork.ch>
Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 MAINTAINERS                                   |   1 +
 arch/arm/dts/Makefile                         |   2 +
 arch/arm/dts/k3-am62l3-bytedevkit-u-boot.dtsi |  29 ++
 arch/arm/dts/k3-am62l3-bytedevkit.dts         | 252 ++++++++++++
 arch/arm/dts/k3-am62l3-byteengine.dtsi        | 103 +++++
 arch/arm/mach-k3/am62lx/Kconfig               |   1 +
 board/bytesatwork/bytedevkit_am62lx/Kconfig   |  61 +++
 board/bytesatwork/bytedevkit_am62lx/Makefile  |   7 +
 board/bytesatwork/bytedevkit_am62lx/README.md |  56 +++
 .../bytedevkit_am62lx/am62lx_bytedevkit.c     |  30 ++
 .../bytedevkit_am62lx/board-cfg.yaml          |  36 ++
 .../bytedevkit_am62lx/sec-cfg.yaml            | 384 ++++++++++++++++++
 configs/am62lx_bytedevkit_defconfig           | 172 ++++++++
 include/configs/am62lx_bytedevkit.h           |  79 ++++
 14 files changed, 1213 insertions(+)
 create mode 100644 arch/arm/dts/k3-am62l3-bytedevkit-u-boot.dtsi
 create mode 100644 arch/arm/dts/k3-am62l3-bytedevkit.dts
 create mode 100644 arch/arm/dts/k3-am62l3-byteengine.dtsi
 create mode 100644 board/bytesatwork/bytedevkit_am62lx/Kconfig
 create mode 100644 board/bytesatwork/bytedevkit_am62lx/Makefile
 create mode 100644 board/bytesatwork/bytedevkit_am62lx/README.md
 create mode 100644 board/bytesatwork/bytedevkit_am62lx/am62lx_bytedevkit.c
 create mode 100644 board/bytesatwork/bytedevkit_am62lx/board-cfg.yaml
 create mode 100644 board/bytesatwork/bytedevkit_am62lx/sec-cfg.yaml
 create mode 100644 configs/am62lx_bytedevkit_defconfig
 create mode 100644 include/configs/am62lx_bytedevkit.h


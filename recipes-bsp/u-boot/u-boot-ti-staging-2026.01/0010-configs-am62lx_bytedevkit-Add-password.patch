From 88419b17e5f37cc286ab6eb9c5d81b2aa82660e8 Mon Sep 17 00:00:00 2001
From: Simone Schwizer <simone.schwizer@bytesatwork.ch>
Date: Mon, 17 Aug 2026 10:17:37 +0200
Subject: [PATCH] configs: am62lx_bytedevkit: Add password

Enables autoboot stop password and sets boot delay to 1 second.

Signed-off-by: Simone Schwizer <simone.schwizer@bytesatwork.ch>
---
 configs/am62lx_bytedevkit_defconfig | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/configs/am62lx_bytedevkit_defconfig b/configs/am62lx_bytedevkit_defconfig
index 7b263b998c1..28f43f735ad 100644
--- a/configs/am62lx_bytedevkit_defconfig
+++ b/configs/am62lx_bytedevkit_defconfig
@@ -47,6 +47,11 @@ CONFIG_EFI_SET_TIME=y
 CONFIG_SPL_FIT_SIGNATURE=y
 CONFIG_SPL_LOAD_FIT_ADDRESS=0x85000000
 CONFIG_BOOTSTD_FULL=y
+CONFIG_BOOTDELAY=1
+CONFIG_AUTOBOOT_KEYED=y
+CONFIG_AUTOBOOT_ENCRYPTION=y
+CONFIG_AUTOBOOT_STOP_STR_ENABLE=y
+CONFIG_AUTOBOOT_STOP_STR_SHA256="746ff992cd97391b15891f93dd1ce02908c33947c60f1a95fc134d40874e5ac0"
 CONFIG_BOOTCOMMAND="run bsp_bootcmd"
 CONFIG_BOARD_LATE_INIT=y
 CONFIG_SPL_MAX_SIZE=0x58000

 arch/arm64/boot/dts/ti/Makefile               |   2 +
 .../boot/dts/ti/k3-am625-bytedevkit-2-2.dts   | 365 ++++++++++++++++++
 .../arm64/boot/dts/ti/k3-am625-bytedevkit.dts | 332 ++++++++++++++++
 .../boot/dts/ti/k3-am625-byteengine.dtsi      | 336 ++++++++++++++++
 5 files changed, 1037 insertions(+)
 create mode 100644 arch/arm64/boot/dts/ti/k3-am625-bytedevkit-2-2.dts
 create mode 100644 arch/arm64/boot/dts/ti/k3-am625-bytedevkit.dts
 create mode 100644 arch/arm64/boot/dts/ti/k3-am625-byteengine.dtsi


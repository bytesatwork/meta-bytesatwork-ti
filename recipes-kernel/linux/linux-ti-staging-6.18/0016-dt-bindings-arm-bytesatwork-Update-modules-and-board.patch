From 3c06f621ee6fbcee8414ea561f682d3ccdbfa0d3 Mon Sep 17 00:00:00 2001
From: Alexander Forsch <alexander.forsch@bytesatwork.ch>
Date: Mon, 20 Jul 2026 14:37:56 +0200
Subject: [PATCH] dt-bindings: arm: bytesatwork: Update modules and boards

Update modules and boards for byteENGINEs and byteDEVKITs.

Signed-off-by: Alexander Forsch <alexander.forsch@bytesatwork.ch>
---
 .../bindings/arm/bytesatwork/bytesatwork.yaml | 17 +++-
 .../display/panel/youritech,ili9806e.yaml     | 84 +++++++++++++++++++
 MAINTAINERS                                   |  1 +
 3 files changed, 100 insertions(+), 2 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/display/panel/youritech,ili9806e.yaml

diff --git a/Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml b/Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml
index 2587e61c70e4..76da32e1e8c0 100644
--- a/Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml
+++ b/Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml
@@ -17,13 +17,26 @@ properties:
       - description: bytesatwork byteENGINE
         items:
           - enum:
+              - bytesatwork,byteengine-am62lx
+              - bytesatwork,byteengine-am62px
               - bytesatwork,byteengine-am62x
-          - const: bytesatwork,byteengine-am62x
+              - bytesatwork,byteengine-imx8mm
+              - bytesatwork,byteengine-imx8mp
+              - bytesatwork,byteengine-imx93
+              - bytesatwork,byteengine-stm32mp1
+              - bytesatwork,byteengine-stm32mp2
+
       - description: bytesatwork byteDEVKIT
         items:
           - enum:
+              - bytesatwork,bytedevkit-am62lx
+              - bytesatwork,bytedevkit-am62px
               - bytesatwork,bytedevkit-am62x
-          - const: bytesatwork,bytedevkit-am62x
+              - bytesatwork,bytedevkit-imx8mm
+              - bytesatwork,bytedevkit-imx8mp
+              - bytesatwork,bytedevkit-imx93
+              - bytesatwork,bytedevkit-stm32mp1
+              - bytesatwork,bytedevkit-stm32mp2
 
 additionalProperties: true
 
diff --git a/Documentation/devicetree/bindings/display/panel/youritech,ili9806e.yaml b/Documentation/devicetree/bindings/display/panel/youritech,ili9806e.yaml
new file mode 100644
index 000000000000..9c5eb2bf2e1f
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/youritech,ili9806e.yaml
@@ -0,0 +1,84 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/youritech,ili9806e.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MIPI-DSI panel with Youritech ILI9806E Controller
+
+maintainers:
+  - Daniel Ammann <daniel.ammann@bytesatwork.ch>
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: youritech,ili9806e
+
+  reg: true
+  port: true
+  reset-gpios: true
+  width-mm: true
+  height-mm: true
+
+  dsi-lanes:
+    description: Number of DSI lanes to be used must be <1> or <2> or <3> or <4>
+    enum: [1, 2, 3, 4]
+
+  video-mode:
+    description: |
+      0 - burst-mode
+      1 - non-burst with sync event
+      2 - non-burst with sync pulse
+      3 - command mode
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [0, 1, 2, 3]
+
+required:
+  - compatible
+  - reg
+  - dsi-lanes
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    &dsi {
+      #address-cells = <1>;
+      #size-cells = <0>;
+      status = "okay";
+
+      panel@0 {
+        compatible = "youritech,ili9806e";
+        reg = <0>;
+        backlight = <&mipi_bl>;
+        reset-gpios = <&gpio2 22 GPIO_ACTIVE_HIGH>;
+        dsi-lanes = <2>;
+        video-mode = <2>;	/* 0: burst mode
+              * 1: non-burst mode with sync event
+              * 2: non-burst mode with sync pulse
+              */
+        width-mm = <68>;
+        height-mm = <121>;
+        status = "okay";
+
+        port {
+          panel_mipi_in: endpoint {
+            remote-endpoint = <&dsi_out>;
+          };
+        };
+      };
+
+      ports {
+        port@1 {
+          reg = <1>;
+
+          dsi_out: endpoint {
+            remote-endpoint = <&panel_mipi_in>;
+          };
+        };
+      };
+    };
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index b1b31c0ee18d..ecf78a058d3b 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -5386,6 +5386,7 @@ S:	Maintained
 F:	.github/workflows/checkpatch.yml
 F:	.gitlab-ci.yml
 F:	Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml
+F:	Documentation/devicetree/bindings/display/panel/youritech,ili9806e.yaml
 F:	arch/arm64/boot/dts/ti/k3-am625-bytedevkit-v2-0.dtb
 F:	arch/arm64/boot/dts/ti/k3-am625-byteengine.dtsi
 F:	arch/arm64/configs/bytedevkit_am62x_defconfig

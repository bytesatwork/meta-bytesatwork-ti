From 6839299331192b223f4f973f2ae53a8953dfc977 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Stephan=20D=C3=BCnner?= <stephan.duenner@bytesatwork.ch>
Date: Tue, 19 May 2026 13:24:00 +0200
Subject: [PATCH] arm64: dts: ti: k3-am62l3-byteengine/bytedevkit: Add
 byteDEVKIT AM62L support
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add support for bytedevkit AM62L.

Signed-off-by: Stephan Dünner <stephan.duenner@bytesatwork.ch>
Signed-off-by: Alexander Forsch <alexander.forsch@bytesatwork.ch>
---
 MAINTAINERS                                   |   2 +
 arch/arm64/boot/dts/ti/Makefile               |   1 +
 .../boot/dts/ti/k3-am62l3-bytedevkit-v2-0.dts | 395 ++++++++++++++++++
 .../boot/dts/ti/k3-am62l3-byteengine.dtsi     |  78 ++++
 4 files changed, 476 insertions(+)
 create mode 100644 arch/arm64/boot/dts/ti/k3-am62l3-bytedevkit-v2-0.dts
 create mode 100644 arch/arm64/boot/dts/ti/k3-am62l3-byteengine.dtsi

diff --git a/MAINTAINERS b/MAINTAINERS
index 5deb44f954c1..30b818892966 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -5389,6 +5389,8 @@ F:	Documentation/devicetree/bindings/arm/bytesatwork/bytesatwork.yaml
 F:	Documentation/devicetree/bindings/display/panel/youritech,ili9806e.yaml
 F:	arch/arm64/boot/dts/ti/k3-am625-bytedevkit-v2-0.dtb
 F:	arch/arm64/boot/dts/ti/k3-am625-byteengine.dtsi
+F:	arch/arm64/boot/dts/ti/k3-am62l3-bytedevkit-v2-0.dtb
+F:	arch/arm64/boot/dts/ti/k3-am62l3-byteengine.dtsi
 F:	arch/arm64/configs/bytedevkit_am62x_defconfig
 F:	drivers/gpu/drm/panel/panel-youritech-ili9806e.c
 
diff --git a/arch/arm64/boot/dts/ti/Makefile b/arch/arm64/boot/dts/ti/Makefile
index d881f5c7b891..48bdcb4fc7bc 100644
--- a/arch/arm64/boot/dts/ti/Makefile
+++ b/arch/arm64/boot/dts/ti/Makefile
@@ -67,6 +67,7 @@ dtb-$(CONFIG_ARCH_K3) += k3-am62l3-evm-pwm.dtbo
 dtb-$(CONFIG_ARCH_K3) += k3-am62l3-badge.dtb
 
 # Boards with AM62Lx SoCs
+dtb-$(CONFIG_ARCH_K3) += k3-am62l3-bytedevkit-v2-0.dtb
 dtb-$(CONFIG_ARCH_K3) += k3-am62l3-evm.dtb
 dtb-$(CONFIG_ARCH_K3) += k3-am62l3-evm-dsi-rpi-7inch-panel.dtbo
 dtb-$(CONFIG_ARCH_K3) += k3-am62l3-evm-lpm-wkup-sources.dtbo
diff --git a/arch/arm64/boot/dts/ti/k3-am62l3-bytedevkit-v2-0.dts b/arch/arm64/boot/dts/ti/k3-am62l3-bytedevkit-v2-0.dts
new file mode 100644
index 000000000000..03961597d3bb
--- /dev/null
+++ b/arch/arm64/boot/dts/ti/k3-am62l3-bytedevkit-v2-0.dts
@@ -0,0 +1,395 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2026 bytesatwork AG - https://www.bytesatwork.io
+ *
+ * based on k3-am62l3-evm.dts:
+ *
+ * Copyright (C) 2021-2022 Texas Instruments Incorporated - https://www.ti.com/
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pwm/pwm.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/net/ti-dp83867.h>
+#include <dt-bindings/thermal/thermal.h>
+#include "k3-am62l3-byteengine.dtsi"
+#include "k3-pinctrl.h"
+
+/ {
+	compatible = "bytesatwork,bytedevkit-am62lx", "bytesatwork,byteengine-am62lx", "ti,am62l3";
+	model = "bytesatwork byteDEVKIT OSM-S Rev2.0 with byteENGINE AM62Lx";
+
+	aliases {
+		gpio0 = &gpio0;
+		mmc1 = &sdhci1;
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	extcon_usb0: extcon-usb0 {
+		compatible = "linux,extcon-usb-gpio";
+		id-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb0_gpio_id_pins>;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+		led0: led-0 {
+			gpios = <&gpio0 87 GPIO_ACTIVE_HIGH>;  // GPIO0_87
+			default-state = "on";
+		};
+		red {
+			gpios = <&gpio_expander 2 GPIO_ACTIVE_LOW>;
+		};
+		green {
+			gpios = <&gpio_expander 3 GPIO_ACTIVE_LOW>;
+		};
+		blue {
+			gpios = <&gpio_expander 4 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	backlight: display-backlight {
+		compatible = "pwm-backlight";
+		pwms = <&epwm0 0 5000000 0>;
+		brightness-levels = <0 4 8 16 32 64 128 255>;
+		default-brightness-level = <6>;
+		default-on;
+		status = "okay";
+	};
+};
+
+&pmx0 {
+	i2c0_pins_default: i2c0-default-pins {
+		pinctrl-single,pins = <
+			AM62LX_IOPAD(0x01cc, PIN_INPUT_PULLUP, 0) /* (B7) I2C0_SCL */
+			AM62LX_IOPAD(0x01d0, PIN_INPUT_PULLUP, 0) /* (A7) I2C0_SDA */
+		>;
+		bootph-all;
+	};
+
+	i2c1_pins_default: i2c1-default-pins {
+		pinctrl-single,pins = <
+			AM62LX_IOPAD(0x01d4, PIN_INPUT_PULLUP, 0) /* (D7) I2C1_SCL */
+			AM62LX_IOPAD(0x01d8, PIN_INPUT_PULLUP, 0) /* (A6) I2C1_SDA */
+		>;
+		bootph-all;
+	};
+
+	mmc1_pins_default: mmc1-default-pins {
+		pinctrl-single,pins = <
+			AM62LX_IOPAD(0x0230, PIN_INPUT, 0) /* (Y3) MMC1_CMD */
+			AM62LX_IOPAD(0x0228, PIN_OUTPUT, 0) /* (Y2) MMC1_CLK */
+			AM62LX_IOPAD(0x0224, PIN_INPUT, 0) /* (AA1) MMC1_DAT0 */
+			AM62LX_IOPAD(0x0220, PIN_INPUT, 0) /* (Y4) MMC1_DAT1 */
+			AM62LX_IOPAD(0x021c, PIN_INPUT, 0) /* (AA2) MMC1_DAT2 */
+			AM62LX_IOPAD(0x0218, PIN_INPUT, 0) /* (AB2) MMC1_DAT3 */
+			AM62LX_IOPAD(0x0234, PIN_INPUT, 0) /* (B6) MMC1_SDCD */
+		>;
+		bootph-all;
+	};
+
+	rgmii1_pins_default: rgmii1-default-pins {
+		pinctrl-single,pins = <
+			AM62LX_IOPAD(0x0138, PIN_INPUT, 0) /* (Y8) RGMII1_RD0 */
+			AM62LX_IOPAD(0x013c, PIN_INPUT, 0) /* (AA6) RGMII1_RD1 */
+			AM62LX_IOPAD(0x0140, PIN_INPUT, 0) /* (AA8) RGMII1_RD2 */
+			AM62LX_IOPAD(0x0144, PIN_INPUT, 0) /* (W8) RGMII1_RD3 */
+			AM62LX_IOPAD(0x0134, PIN_INPUT, 0) /* (Y7) RGMII1_RXC */
+			AM62LX_IOPAD(0x0130, PIN_INPUT, 0) /* (Y6) RGMII1_RX_CTL */
+			AM62LX_IOPAD(0x0120, PIN_OUTPUT, 0) /* (AC10) RGMII1_TD0 */
+			AM62LX_IOPAD(0x0124, PIN_OUTPUT, 0) /* (W13) RGMII1_TD1 */
+			AM62LX_IOPAD(0x0128, PIN_OUTPUT, 0) /* (Y11) RGMII1_TD2 */
+			AM62LX_IOPAD(0x012c, PIN_OUTPUT, 0) /* (AA11) RGMII1_TD3 */
+			AM62LX_IOPAD(0x011c, PIN_OUTPUT, 0) /* (W11) RGMII1_TXC */
+			AM62LX_IOPAD(0x0118, PIN_OUTPUT, 0) /* (AB11) RGMII1_TX_CTL */
+		>;
+	};
+
+	rgmii2_pins_default: rgmii2-default-pins {
+		pinctrl-single,pins = <
+			AM62LX_IOPAD(0x0170, PIN_INPUT, 0) /* (AB9) RGMII2_RD0 */
+			AM62LX_IOPAD(0x0174, PIN_INPUT, 0) /* (AC9) RGMII2_RD1 */
+			AM62LX_IOPAD(0x0178, PIN_INPUT, 0) /* (AB10) RGMII2_RD2 */
+			AM62LX_IOPAD(0x017c, PIN_INPUT, 0) /* (AB8) RGMII2_RD3 */
+			AM62LX_IOPAD(0x016c, PIN_INPUT, 0) /* (AC7) RGMII2_RXC */
+			AM62LX_IOPAD(0x0168, PIN_INPUT, 0) /* (AC8) RGMII2_RX_CTL */
+			AM62LX_IOPAD(0x0158, PIN_OUTPUT, 0) /* (AC12) RGMII2_TD0 */
+			AM62LX_IOPAD(0x015c, PIN_OUTPUT, 0) /* (AB13) RGMII2_TD1 */
+			AM62LX_IOPAD(0x0160, PIN_OUTPUT, 0) /* (AA12) RGMII2_TD2 */
+			AM62LX_IOPAD(0x0164, PIN_OUTPUT, 0) /* (AA13) RGMII2_TD3 */
+			AM62LX_IOPAD(0x0154, PIN_OUTPUT, 0) /* (Y13) RGMII2_TXC */
+			AM62LX_IOPAD(0x0150, PIN_OUTPUT, 0) /* (AB12) RGMII2_TX_CTL */
+		>;
+	};
+
+	mdio1_pins_default: mdio1-default-pins {
+		pinctrl-single,pins = <
+			AM62LX_IOPAD(0x014c, PIN_OUTPUT, 0) /* (AC15) MDIO0_MDC */
+			AM62LX_IOPAD(0x0148, PIN_INPUT, 0) /* (AC13) MDIO0_MDIO */
+		>;
+	};
+
+	uart0_pins_default: uart0-default-pins {
+		pinctrl-single,pins = <
+			AM62LX_IOPAD(0x01b4, PIN_INPUT, 0) /* (D13) UART0_RXD */
+			AM62LX_IOPAD(0x01b8, PIN_OUTPUT, 0) /* (C13) UART0_TXD */
+		>;
+	};
+
+	usb0_default_pins: usb0-default-pins {
+		pinctrl-single,pins = <
+			AM62LX_IOPAD(0x0244, PIN_OUTPUT, 0) /* (A5) USB0_DRVVBUS */
+		>;
+	};
+
+	usb0_gpio_id_pins: usb0-id-pins {
+		pinctrl-single,pins = <
+			AM62LX_IOPAD(0x006c, PIN_INPUT, 7) /* (D20) OSPI0_CSn1.GPIO0_12 */
+		>;
+	};
+
+	usb1_default_pins: usb1-default-pins {
+		pinctrl-single,pins = <
+			AM62LX_IOPAD(0x0248, PIN_OUTPUT, 0) /* (A5) USB1_DRVVBUS */
+		>;
+	};
+
+	wkup_display_gpio_pins_default: wkup-display-gpio-pins {
+		pinctrl-single,pins = <
+			AM62LX_IOPAD(0x000c,
+				PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL,
+				7) /* (W22) WKUP_UART0_RTSn.WKUP_GPIO0_3 */
+			AM62LX_IOPAD(0x0004,
+				PIN_OUTPUT |PIN_DRIVE_STRENGTH_NOMINAL,
+				7) /* (AA23) WKUP_UART0_TXD.WKUP_GPIO0_1 */
+		>;
+	};
+
+	backlight_pins_default: backlight-gpio-pins {
+		pinctrl-single,pins = <
+			AM62LX_IOPAD(0x01a0,
+				PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL,
+				7) /* (E11) SPI0_CS0.EHRPWM0_A Mode 2*/
+		>;
+	};
+
+	touch_gpio_pins_default: touch-gpio-pins {
+		pinctrl-single,pins = <
+			AM62LX_IOPAD(0x0000,
+				PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL,
+				7) /* (Y22) WKUP_UART0_RXD.WKUP_GPIO0_0 */
+			AM62LX_IOPAD(0x0008,
+				PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL,
+				7) /* (W23) WKUP_UART0_CTSn.WKUP_GPIO0_2 */
+		>;
+	};
+};
+
+&gpio0 {
+	status = "okay";
+	bootph-all;
+};
+
+&gpio2 {
+	status = "okay";
+	bootph-all;
+};
+
+&wkup_gpio0 {
+	bootph-all;
+	status = "okay";
+	gpio-line-names ="TOUCH_RST","","TOUCH_INT","MIPI_RST","","","",""; //GPIO0_0->7
+};
+
+&i2c0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c0_pins_default>;
+	clock-frequency = <400000>;
+	status = "okay";
+
+	gpio_expander: gpio@71 {
+		compatible = "ti,tca9538";
+		reg = <0x71>;
+		gpio-controller;
+		#gpio-cells = <2>;
+	};
+};
+
+&i2c1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c1_pins_default>,<&touch_gpio_pins_default>;
+	clock-frequency = <400000>;
+	status = "okay";
+
+	touchscreen@14 {
+		compatible = "goodix,gt911";
+		reg = <0x14>;
+		interrupt-parent = <&wkup_gpio0>;
+		interrupts = <2 0>;
+		irq-gpios = <&wkup_gpio0 2 0>;
+		reset-gpios = <&wkup_gpio0 0 0>;
+	};
+};
+
+&sdhci1 {
+	status = "okay";
+	/* SD/MMC */
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc1_pins_default>;
+	cap-sd-highspeed;
+	max-frequency = <25000000>;
+	no-1-8-v;
+	sd-uhs-sdr25;
+	disable-wp;
+	status = "okay";
+	bootph-all;
+};
+
+&cpsw3g {
+	pinctrl-names = "default";
+	pinctrl-0 = <&rgmii1_pins_default>,
+			<&rgmii2_pins_default>;
+	status = "okay";
+};
+
+&cpsw_port1 {
+	phy-mode = "rgmii-rxid"; /* TX delay */
+	phy-handle = <&cpsw3g_phy0>;
+	status = "okay";
+};
+
+&cpsw_port2 {
+	phy-mode = "rgmii-rxid"; /* TX delay */
+	phy-handle = <&cpsw3g_phy1>;
+	status = "okay";
+};
+
+&cpsw3g_mdio {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mdio1_pins_default>;
+	status = "okay";
+
+	cpsw3g_phy0: ethernet-phy@0 {
+		reg = <0>;
+		ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
+		ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
+		ti,min-output-impedance;
+	};
+
+	cpsw3g_phy1: ethernet-phy@1 {
+		reg = <12>;
+		ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
+		ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
+		ti,min-output-impedance;
+	};
+};
+
+&uart0 {
+	pinctrl-0 = <&uart0_pins_default>;
+	pinctrl-names = "default";
+	status = "okay";
+	bootph-all;
+};
+
+&usb0 {
+	status = "okay";
+	dr_mode = "host";
+	pinctrl-names = "default";
+	pinctrl-0 = <&usb0_default_pins>;
+	extcon = <&extcon_usb0>;
+	usb-role-switch;
+};
+
+&usb1 {
+	dr_mode = "host";
+	pinctrl-names = "default";
+	pinctrl-0 = <&usb1_default_pins>;
+};
+
+&dss {
+	status = "okay";
+};
+
+&main_bcdma {
+	bootph-all;
+};
+
+&main_pktdma {
+	bootph-all;
+};
+
+&dphy_tx0 {
+	status = "okay";
+};
+
+&dss_ports {
+	port@0 {
+		reg = <0>;
+		dss_out: endpoint {
+			remote-endpoint = <&dsi0_in>;
+		};
+	};
+};
+
+&dsi0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			dsi0_out: endpoint {
+					remote-endpoint = <&dsi_panel_in>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+				dsi0_in: endpoint {
+				remote-endpoint = <&dss_out>;
+			};
+		};
+	};
+
+	panel@0 {
+		pinctrl-0 = <&wkup_display_gpio_pins_default>;
+		pinctrl-names = "default";
+		compatible = "youritech,ili9806e";
+		reg = <0>;
+		reset-gpios = <&wkup_gpio0 3 GPIO_ACTIVE_HIGH>; /*W22WKUP_UART0_RTSn.WKUP_GPIO0_3*/
+		backlight = <&backlight>;
+		dsi-lanes = <2>;
+		video-mode = <0>;       /* 0: burst mode
+					 * 1: non-burst mode with sync event
+					 * 2: non-burst mode with sync pulse
+					 */
+		width-mm = <68>;
+		height-mm = <121>;
+
+		status = "okay";
+
+		port {
+			dsi_panel_in: endpoint {
+				remote-endpoint = <&dsi0_out>;
+			};
+		};
+	};
+};
+
+&epwm0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&backlight_pins_default>;
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/ti/k3-am62l3-byteengine.dtsi b/arch/arm64/boot/dts/ti/k3-am62l3-byteengine.dtsi
new file mode 100644
index 000000000000..612b951905d0
--- /dev/null
+++ b/arch/arm64/boot/dts/ti/k3-am62l3-byteengine.dtsi
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2026 bytesatwork AG - https://www.bytesatwork.io
+ *
+ * based on k3-am62l3-evm.dts:
+ *
+ * Copyright (C) 2021-2022 Texas Instruments Incorporated - https://www.ti.com/
+ */
+
+#include "k3-am62l3.dtsi"
+
+/ {
+	compatible = "bytesatwork,byteengine-am62lx", "ti,am62l3";
+
+	aliases {
+		mmc0 = &sdhci0;
+	};
+
+	memory@80000000 {
+		/* 2G RAM */
+		reg = <0x00000000 0x80000000 0x00000000 0x80000000>;
+		device_type = "memory";
+		bootph-all;
+	};
+
+	thermal-zones {
+		wkup0-thermal {
+			polling-delay-passive = <250>;	/* milliSeconds */
+			polling-delay = <500>;		/* milliSeconds */
+			thermal-sensors = <&vtm0 0>;
+
+			trips {
+				crit0 {
+					temperature = <125000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
+		};
+	};
+};
+
+&pmx0 {
+	mmc0_pins_default: mmc0-default-pins {
+		pinctrl-single,pins = <
+			AM62LX_IOPAD(0x0214, PIN_INPUT, 0) /* (D2) MMC0_CMD */
+			AM62LX_IOPAD(0x020c, PIN_OUTPUT, 0) /* (B2) MMC0_CLK */
+			AM62LX_IOPAD(0x0208, PIN_INPUT, 0) /* (D3) MMC0_DAT0 */
+			AM62LX_IOPAD(0x0204, PIN_INPUT_PULLUP, 0) /* (D4) MMC0_DAT1 */
+			AM62LX_IOPAD(0x0200, PIN_INPUT_PULLUP, 0) /* (C1) MMC0_DAT2 */
+			AM62LX_IOPAD(0x01fc, PIN_INPUT_PULLUP, 0) /* (C2) MMC0_DAT3 */
+			AM62LX_IOPAD(0x01f8, PIN_INPUT_PULLUP, 0) /* (C4) MMC0_DAT4 */
+			AM62LX_IOPAD(0x01f4, PIN_INPUT_PULLUP, 0) /* (B3) MMC0_DAT5 */
+			AM62LX_IOPAD(0x01f0, PIN_INPUT_PULLUP, 0) /* (A3) MMC0_DAT6 */
+			AM62LX_IOPAD(0x01ec, PIN_INPUT_PULLUP, 0) /* (B4) MMC0_DAT7 */
+		>;
+		bootph-all;
+	};
+};
+
+&sdhci0 {
+	/* eMMC */
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc0_pins_default>;
+	non-removable;
+	status = "okay";
+	bootph-all;
+};
+
+&usbss0 {
+	status = "okay";
+	ti,vbus-divider;
+};
+
+&usbss1 {
+	status = "okay";
+	ti,vbus-divider;
+};
